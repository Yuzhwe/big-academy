{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "vite/client", "@testing-library/jest-dom"],
    "paths": {
      "@big-academy/design-system": ["./packages/design-system/src/index.ts"]
    }
  },
  "include": [
    "vitest.setup.ts",
    "apps/library/src/**/*.test.tsx",
    "packages/design-system/src/**/*.test.tsx",
    "packages/design-system/src/**/*.stories.tsx",
    "apps/writing/src/**/*.test.tsx",
    "apps/writing/src/**/*.stories.tsx",
    "apps/writing/.storybook/**/*.ts",
    "apps/writing/.storybook/**/*.tsx",
    "apps/writing/e2e/**/*.ts",
    "apps/writing/playwright.config.ts"
  ]
}
