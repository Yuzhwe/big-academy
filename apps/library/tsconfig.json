{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "types": ["vite/client"],
    "paths": { "@big-academy/design-system": ["../../packages/design-system/src/index.ts"] }
  },
  "include": ["src"], "exclude": ["src/**/*.test.tsx"]
}
